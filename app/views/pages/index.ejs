<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulário de Contato</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/app/css/style.css">
</head>
<body class="bg-light">

    <main class="container my-5">
        <section class="row justify-content-center">
            <article class="col-md-8 col-lg-6 card shadow p-0">
                
                <header class="card-header bg-white border-0 pt-4 pb-0">
                    <h2 class="card-title text-center text-primary mb-0">Formulário de Contato</h2>
                </header>

                <section class="card-body p-4">
                    
                    <!-- Alerta de Erros -->
                    <% if (listaErros && listaErros.array().length > 0) { %>
                        <section class="alert alert-danger" role="alert">
                            <ul class="mb-0 ps-3">
                                <% listaErros.array().forEach(function(erro) { %>
                                    <li><%= erro.msg %></li>
                                <% }) %>
                            </ul>
                        </section>
                    <% } %>

                    <!-- Alerta de Sucesso -->
                    <% if (resultado) { %>
                        <section class="alert alert-success" role="alert">
                            E-mail enviado com sucesso! Dados recebidos.
                        </section>
                    <% } %>

                    <form action="/index" method="POST">
                        <p class="mb-3">
                            <label for="nome" class="form-label">Nome:</label>
                            <input type="text" class="form-control" id="nome" name="nome" value="<%= campos ? campos.nome : '' %>" placeholder="Seu nome completo">
                        </p>

                        <p class="mb-3">
                            <label for="email" class="form-label">E-mail:</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= campos ? campos.email : '' %>" placeholder="seuemail@exemplo.com">
                        </p>

                        <p class="mb-3">
                            <label for="telefone" class="form-label">Telefone:</label>
                            <input type="text" class="form-control" id="telefone" name="telefone" value="<%= campos ? campos.telefone : '' %>" placeholder="(11) 99999-9999">
                        </p>

                        <p class="mb-3">
                            <label for="assunto" class="form-label">Assunto:</label>
                            <input type="text" class="form-control" id="assunto" name="assunto" value="<%= campos ? campos.assunto : '' %>" placeholder="Assunto da mensagem">
                        </p>

                        <p class="mb-3">
                            <label for="mensagem" class="form-label">Mensagem:</label>
                            <textarea class="form-control" id="mensagem" name="mensagem" rows="4" placeholder="Escreva sua mensagem..."><%= campos ? campos.mensagem : '' %></textarea>
                        </p>

                        <footer class="mt-4">
                            <button type="submit" class="btn btn-primary w-100 btn-lg">Enviar</button>
                        </footer>
                    </form>

                </section>
            </article>
        </section>
    </main>

</body>
</html>